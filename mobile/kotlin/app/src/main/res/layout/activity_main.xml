<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_chat_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/nativeContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/tabDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/ios_divider" />

    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_height"
        android:background="@color/ios_surface"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout android:id="@+id/tabChats" style="@style/WaabaTab">
            <ImageView
                android:id="@+id/tabChatsIcon"
                style="@style/WaabaTabIcon"
                android:src="@drawable/tab_chats_selector" />
            <TextView
                android:id="@+id/tabChatsLabel"
                style="@style/WaabaTabLabel"
                android:text="@string/tab_chats" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tabContacts" style="@style/WaabaTab">
            <ImageView
                android:id="@+id/tabContactsIcon"
                style="@style/WaabaTabIcon"
                android:src="@drawable/tab_contacts_selector" />
            <TextView
                android:id="@+id/tabContactsLabel"
                style="@style/WaabaTabLabel"
                android:text="@string/tab_contacts" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tabSettings" style="@style/WaabaTab">
            <ImageView
                android:id="@+id/tabSettingsIcon"
                style="@style/WaabaTabIcon"
                android:src="@drawable/tab_settings_selector" />
            <TextView
                android:id="@+id/tabSettingsLabel"
                style="@style/WaabaTabLabel"
                android:text="@string/tab_settings" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tabProfile" style="@style/WaabaTab">
            <ImageView
                android:id="@+id/tabProfileIcon"
                style="@style/WaabaTabIcon"
                android:src="@drawable/tab_profile_selector" />
            <TextView
                android:id="@+id/tabProfileLabel"
                style="@style/WaabaTabLabel"
                android:text="@string/tab_profile" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
