<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_avatar"
            android:fontFamily="@font/ios_bold"
            android:gravity="center"
            android:text="@string/login_logo"
            android:textColor="@color/ios_incoming"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/ios_bold"
            android:text="@string/login_title"
            android:textColor="@color/ios_text"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/ios_regular"
            android:text="@string/login_subtitle"
            android:textColor="@color/ios_text_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ios_medium"
                android:text="@string/login_email_label"
                android:textColor="@color/ios_text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/loginEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/ios_incoming"
                android:fontFamily="@font/ios_regular"
                android:hint="@string/login_email_hint"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="@color/ios_text"
                android:textColorHint="@color/ios_text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/ios_medium"
                android:text="@string/login_password_label"
                android:textColor="@color/ios_text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/loginPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/ios_incoming"
                android:fontFamily="@font/ios_regular"
                android:hint="@string/login_password_hint"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/ios_text"
                android:textColorHint="@color/ios_text_muted"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/loginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/ios_regular"
            android:textColor="@color/ios_danger"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/loginProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/waaba_green"
            android:visibility="gone" />

        <TextView
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:fontFamily="@font/ios_medium"
            android:gravity="center"
            android:text="@string/login_button"
            android:textColor="@color/waaba_green"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/ios_regular"
            android:text="@string/version"
            android:textColor="@color/ios_text_muted"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
